---
import SEOHead from '@/components/SEOHead.astro';
import JsonLd from '@/components/JsonLd.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  jsonLdType?: 'landing' | 'article' | 'tutorial' | 'example' | 'comparison' | 'faq';
  jsonLdData?: Record<string, any>;
  breadcrumbs?: Array<{ name: string; url: string }>;
  fullWidth?: boolean;
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags,
  noindex,
  jsonLdType,
  jsonLdData,
  breadcrumbs = [{ name: 'Home', url: '/' }],
  fullWidth = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="bg-dark text-text">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <SEOHead
    title={title}
    description={description}
    image={image}
    type={type}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    author={author}
    tags={tags}
    noindex={noindex}
  />
  {jsonLdType && (
    <JsonLd type={jsonLdType} data={jsonLdData} breadcrumbs={breadcrumbs} />
  )}
</head>
<body class="min-h-screen flex flex-col font-sans antialiased">
  <Nav />
  <main class={fullWidth ? '' : 'max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full'}>
    <slot />
  </main>
  <Footer />
</body>
</html>
