---
interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  title,
  subtitle,
  ctaText = 'Try the Playground',
  ctaHref = '/playground',
  secondaryCtaText,
  secondaryCtaHref,
} = Astro.props;
---

<section class="relative py-20 md:py-32 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent"></div>
  <div class="relative max-w-4xl mx-auto text-center px-4">
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight">
      <Fragment set:html={title} />
    </h1>
    <p class="mt-6 text-lg md:text-xl text-text-muted max-w-2xl mx-auto leading-relaxed">
      {subtitle}
    </p>
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={ctaHref}
        class="inline-flex items-center justify-center px-8 py-3 rounded-lg bg-primary hover:bg-primary-dark text-white font-semibold text-lg transition-colors shadow-lg shadow-primary/25"
      >
        {ctaText}
      </a>
      {secondaryCtaText && secondaryCtaHref && (
        <a
          href={secondaryCtaHref}
          class="inline-flex items-center justify-center px-8 py-3 rounded-lg border border-border hover:border-primary/50 text-white font-semibold text-lg transition-colors"
        >
          {secondaryCtaText}
        </a>
      )}
    </div>
  </div>
</section>
