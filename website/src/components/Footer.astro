---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-darker py-12 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-1">
        <a href="/" class="text-xl font-bold text-white">
          <span class="text-primary">Sol</span>Script
        </a>
        <p class="mt-3 text-sm text-text-muted">
          Write Solana smart contracts in Solidity. Familiar syntax, powerful blockchain.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Product</h3>
        <ul class="mt-4 space-y-2">
          <li><a href="/playground" class="text-sm text-text-muted hover:text-white transition-colors">Playground</a></li>
          <li><a href="/examples" class="text-sm text-text-muted hover:text-white transition-colors">Examples</a></li>
          <li><a href="https://docs.cryptuon.com/solscript" class="text-sm text-text-muted hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">Documentation</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Learn</h3>
        <ul class="mt-4 space-y-2">
          <li><a href="/blog" class="text-sm text-text-muted hover:text-white transition-colors">Blog</a></li>
          <li><a href="/tutorials" class="text-sm text-text-muted hover:text-white transition-colors">Tutorials</a></li>
          <li><a href="/compare/solidity-vs-anchor" class="text-sm text-text-muted hover:text-white transition-colors">SolScript vs Anchor</a></li>
          <li><a href="/compare/solscript-vs-solang-vs-neon" class="text-sm text-text-muted hover:text-white transition-colors">SolScript vs Solang vs Neon</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Community</h3>
        <ul class="mt-4 space-y-2">
          <li><a href="https://github.com/cryptuon/solscript" class="text-sm text-text-muted hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href="https://github.com/cryptuon/solscript/issues" class="text-sm text-text-muted hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">Report Issues</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-border flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-text-muted">&copy; {year} SolScript. Open source under MIT license.</p>
      <div class="flex gap-4">
        <a href="/llms.txt" class="text-xs text-text-muted hover:text-white transition-colors">llms.txt</a>
        <a href="/sitemap-index.xml" class="text-xs text-text-muted hover:text-white transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
