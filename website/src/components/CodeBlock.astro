---
interface Props {
  code: string;
  language?: string;
  title?: string;
}

const { code, language = 'solidity', title } = Astro.props;
---

<div class="rounded-xl overflow-hidden border border-border bg-surface">
  {title && (
    <div class="px-4 py-2 border-b border-border bg-surface-light text-sm text-text-muted font-mono">
      {title}
    </div>
  )}
  <pre class="p-4 overflow-x-auto text-sm leading-relaxed" data-language={language}><code>{code}</code></pre>
</div>
