---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['w-full', className]} style="height: calc(100vh - 4rem);">
  <iframe
    src="/playground/"
    title="SolScript Playground - Online Solidity-to-Solana IDE"
    class="w-full h-full border-0"
    loading="lazy"
    allow="clipboard-write"
  ></iframe>
</div>
