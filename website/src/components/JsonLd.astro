---
interface Props {
  type: 'landing' | 'article' | 'tutorial' | 'example' | 'comparison' | 'faq';
  data?: Record<string, any>;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const { type, data = {}, breadcrumbs = [] } = Astro.props;
const siteUrl = Astro.site?.href || 'https://solscript.cryptuon.com';

function buildSchemas() {
  const schemas: Record<string, any>[] = [];

  // Breadcrumbs for all pages
  if (breadcrumbs.length > 0) {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.name,
        item: crumb.url,
      })),
    });
  }

  const organization = {
    '@type': 'Organization',
    name: 'SolScript',
    url: siteUrl,
    logo: `${siteUrl}favicon.svg`,
    sameAs: [
      'https://github.com/cryptuon/solscript',
    ],
  };

  if (type === 'landing') {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'SolScript',
      description: 'A Solidity-to-Solana compiler that lets Ethereum developers write Solana smart contracts using familiar Solidity syntax.',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Web, Linux, macOS, Windows',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      author: organization,
      featureList: [
        'Solidity syntax compiles to Solana BPF programs',
        'Automatic PDA mapping from Solidity mappings',
        'Full Anchor framework compatibility',
        'Browser-based WASM compiler',
        'SPL Token operations built-in',
        'VS Code extension with LSP',
      ],
      softwareVersion: '0.1.1',
      programmingLanguage: 'Solidity',
    });

    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'SolScript',
      url: siteUrl,
      description: 'Write Solana smart contracts in Solidity syntax',
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}blog?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    });

    schemas.push({
      '@context': 'https://schema.org',
      ...organization,
    });
  }

  if (type === 'article') {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: data.title,
      description: data.description,
      author: {
        '@type': 'Person',
        name: data.author || 'SolScript Team',
        url: siteUrl,
      },
      publisher: organization,
      datePublished: data.pubDate,
      dateModified: data.modifiedDate || data.pubDate,
      image: data.image ? `${siteUrl}${data.image}` : `${siteUrl}og-image.png`,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': data.url || siteUrl,
      },
      wordCount: data.wordCount,
      articleSection: data.section || 'Technology',
      keywords: data.tags?.join(', '),
    });
  }

  if (type === 'tutorial') {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: data.title,
      description: data.description,
      totalTime: data.duration || 'PT30M',
      tool: [
        { '@type': 'HowToTool', name: 'SolScript Compiler' },
        { '@type': 'HowToTool', name: 'Web Browser' },
      ],
      step: (data.steps || []).map((step: any, i: number) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: step.name,
        text: step.text,
      })),
    });

    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: data.title,
      description: data.description,
      proficiencyLevel: data.difficulty || 'Beginner',
      dependencies: 'SolScript Playground or CLI',
      author: {
        '@type': 'Person',
        name: data.author || 'SolScript Team',
      },
      publisher: organization,
      datePublished: data.pubDate,
    });
  }

  if (type === 'example') {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: data.title,
      description: data.description,
      codeRepository: 'https://github.com/cryptuon/solscript',
      codeSampleType: 'full',
      programmingLanguage: {
        '@type': 'ComputerLanguage',
        name: 'SolScript (Solidity for Solana)',
      },
      runtimePlatform: 'Solana',
      targetProduct: {
        '@type': 'SoftwareApplication',
        name: 'SolScript',
      },
    });
  }

  if (type === 'comparison' || type === 'faq') {
    if (data.faqs && data.faqs.length > 0) {
      schemas.push({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faqs.map((faq: any) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      });
    }
  }

  return schemas;
}

const schemas = buildSchemas();
---

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
