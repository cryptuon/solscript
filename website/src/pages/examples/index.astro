---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';

const examples = (await getCollection('examples'))
  .sort((a, b) => a.data.order - b.data.order);

const difficultyColors: Record<string, string> = {
  beginner: 'text-green-400 bg-green-400/10 border-green-400/20',
  intermediate: 'text-yellow-400 bg-yellow-400/10 border-yellow-400/20',
  advanced: 'text-red-400 bg-red-400/10 border-red-400/20',
};
---

<Base
  title="Examples - SolScript Smart Contract Examples"
  description="Browse example Solana smart contracts written in SolScript: tokens, AMMs, staking pools, multisig wallets, escrow, and more. Open any example in the playground."
  tags={['solscript examples', 'solana contract examples', 'solidity solana code', 'smart contract samples']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Examples', url: '/examples' },
  ]}
>
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold text-white mb-3">Examples</h1>
    <p class="text-text-muted text-lg mb-10">Real smart contracts written in SolScript. Browse the source, then open them in the playground to compile and deploy.</p>

    <div class="grid md:grid-cols-2 gap-6">
      {examples.map((example) => (
        <article class="rounded-xl border border-border bg-surface p-6 hover:border-primary/30 transition-colors">
          <a href={`/examples/${example.id}`} class="block">
            <div class="flex items-center gap-2 mb-3">
              <span class={`text-xs px-2 py-1 rounded-md border font-medium ${difficultyColors[example.data.difficulty]}`}>
                {example.data.difficulty}
              </span>
            </div>
            <h2 class="text-lg font-semibold text-white mb-2 hover:text-primary transition-colors">{example.data.title}</h2>
            <p class="text-text-muted text-sm leading-relaxed">{example.data.description}</p>
            {example.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {example.data.tags.map((tag) => (
                  <span class="text-xs px-2 py-0.5 rounded bg-surface-light text-text-muted">{tag}</span>
                ))}
              </div>
            )}
          </a>
        </article>
      ))}
    </div>
  </div>
</Base>
