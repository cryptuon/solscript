---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorials'))
  .sort((a, b) => a.data.order - b.data.order);

const difficultyColors: Record<string, string> = {
  beginner: 'text-green-400 bg-green-400/10',
  intermediate: 'text-yellow-400 bg-yellow-400/10',
  advanced: 'text-red-400 bg-red-400/10',
};
---

<Base
  title="Tutorials - SolScript"
  description="Step-by-step tutorials for building Solana smart contracts with SolScript. From first contract to advanced DeFi patterns."
  tags={['solscript tutorials', 'solana tutorial', 'solidity solana guide', 'smart contract tutorial']}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tutorials', url: '/tutorials' },
  ]}
>
  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold text-white mb-3">Tutorials</h1>
    <p class="text-text-muted text-lg mb-10">Learn to build Solana smart contracts with SolScript, step by step.</p>

    {tutorials.length === 0 ? (
      <p class="text-text-muted">Tutorials coming soon!</p>
    ) : (
      <div class="space-y-6">
        {tutorials.map((tutorial, index) => (
          <article class="rounded-xl border border-border bg-surface p-6 hover:border-primary/30 transition-colors">
            <a href={`/tutorials/${tutorial.id}`} class="block">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-sm font-mono text-text-muted">#{index + 1}</span>
                <span class={`text-xs px-2 py-1 rounded-md font-medium ${difficultyColors[tutorial.data.difficulty]}`}>
                  {tutorial.data.difficulty}
                </span>
                <span class="text-xs text-text-muted">{tutorial.data.duration}</span>
              </div>
              <h2 class="text-xl font-semibold text-white mb-2 hover:text-primary transition-colors">{tutorial.data.title}</h2>
              <p class="text-text-muted leading-relaxed">{tutorial.data.description}</p>
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</Base>
